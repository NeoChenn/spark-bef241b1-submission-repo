                        colorSpace = "raw"
                    )
                    asset inputs:paint_diff = @../assets/third_party/textures/green_metal_rust_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    float inputs:paint_scale = 0.31415927
                    color3f inputs:paint_tint = (0.95, 1, 0.92)
                    float inputs:pipe_r = 0.15
                    float inputs:pipe_y = -5.75
                    float inputs:pipe_z = 43.6
                    asset inputs:rust_diff = @../assets/third_party/textures/rust_coarse_01_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:rust_normal = @../assets/third_party/textures/rust_coarse_01_4k/nor_gl.jpg@ (
                        colorSpace = "raw"
                    )
                    asset inputs:rust_rough = @../assets/third_party/textures/rust_coarse_01_4k/rough.jpg@ (
                        colorSpace = "raw"
                    )
                    float inputs:rust_scale = 0.31415927
                    asset inputs:scale_diff = @../assets/third_party/textures/Rust007_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:scale_normal = @../assets/third_party/textures/Rust007_4k/nor_gl.jpg@ (
                        colorSpace = "raw"
                    )
                    float inputs:wetness = 0.64
                    token outputs:out
                }
            }

            over "rusty_painted_metal"
            {
                token outputs:mdl:surface.connect = </World/RepairZone/Looks/rusty_painted_metal/hero_mdl.outputs:out>
                token outputs:surface.connect = </World/RepairZone/Looks/rusty_painted_metal/hero_mdl.outputs:out>

                def Shader "hero_mdl"
                {
                    uniform token info:implementationSource = "sourceAsset"
