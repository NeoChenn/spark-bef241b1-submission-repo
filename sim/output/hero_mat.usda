                    asset inputs:rust_diff = @../assets/third_party/textures/Rust007_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:rust_normal = @../assets/third_party/textures/Rust007_4k/nor_gl.jpg@ (
