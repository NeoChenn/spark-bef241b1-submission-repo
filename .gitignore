# Secrets: never commit these. A leaked Gemini key gets the whole project's keys revoked.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Run output
logs/
runs/
renders/
*.mp4
*.mov

# Training artefacts (large)
checkpoints/
*.ckpt
*.pt
*.zip

# Node (for the console, when added)
node_modules/
.next/
.vercel/

# Team: per-agent work dirs and generated reports
.superpowers/
.work/
