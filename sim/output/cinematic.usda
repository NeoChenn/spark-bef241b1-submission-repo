#usda 1.0
(
    customLayerData = {
        dictionary renderSettings = {
            bool "rtx:fog:enabled" = 1
            float3 "rtx:fog:fogColor" = (0.05, 0.16, 0.18)
            double "rtx:fog:fogColorIntensity" = 1
            double "rtx:fog:fogDistanceDensity" = 0
            double "rtx:fog:fogHeightDensity" = 0.002
            double "rtx:fog:fogHeightFalloff" = 0.12
            double "rtx:fog:fogStartHeight" = 0
            bool "rtx:fog:fogZup:enabled" = 1
            bool "rtx:post:lensFlares:enabled" = 1
            double "rtx:post:lensFlares:flareScale" = 0.08
            bool "rtx:post:lensFlares:physicalSettings" = 0
        }
    }
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @leak_flanges.usda@,
        @full_rig.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Environment"
    {
        over "sea" (
            active = false
        )
        {
        }

        over "sky"
        {
            float inputs:intensity = 400
            asset inputs:texture:file = @../assets/generated/sky_night.hdr@
            float xformOp:rotateZ = 40
        }

        over "sun"
        {
            color3f inputs:color = (0.7, 0.85, 1)
            float inputs:intensity = 0
            float3 xformOp:rotateXYZ = (55, 15, 35)
        }
    }

    def Scope "Cinematic"
    {
        def Scope "Lamps"
        {
            def Xform "lamp_000"
            {
                double3 xformOp:translate = (-25, 26.6, 46)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Sphere "bulb" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Looks/lamp_amber>
                    double radius = 0.34
                }

                def SphereLight "light"
                {
                    color3f inputs:color = (1, 0.56, 0.17)
                    float inputs:intensity = 240000
                    float inputs:radius = 0.25
                    custom float spark:baseIntensity = 240000
                }
            }

            def Xform "lamp_001"
