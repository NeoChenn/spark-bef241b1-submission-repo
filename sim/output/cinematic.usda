                matrix4d xformOp:transform = ( (0.7990104478368706, 0.6013171411555831, 8.914352169001445e-18, -0), (0.09774607543788993, -0.1298817714722647, 0.986699766988782, 0), (0.5933194830645744, -0.7883834227022427, -0.16255328303139024, 0), (75, -105, 4.000000000000006, 1) )
                uniform token[] xformOpOrder = ["xformOp:transform"]
            }
        }
    }

