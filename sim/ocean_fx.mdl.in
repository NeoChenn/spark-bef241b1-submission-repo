mdl 1.7;

import ::df::*;
import ::state::*;
import ::math::*;
import ::anno::*;

const int BIG_COUNT = @BIG_COUNT@;
const float4[BIG_COUNT] BIG_A = float4[](@BIG_A@);
const float4[BIG_COUNT] BIG_B = float4[](@BIG_B@);
const int WAVE_COUNT = @WAVE_COUNT@;
const float4[WAVE_COUNT] WAVE_A = float4[](@WAVE_A@);
const float4[WAVE_COUNT] WAVE_B = float4[](@WAVE_B@);
const int LEG_COUNT = @LEG_COUNT@;
const float3[@LEG_SLOTS@] LEGS = float3[](@LEGS@);
const float2 DRIFT = @DRIFT@;
const float FADE = @FADE@;

struct sea {
    float3 n;
    float h;
    float jac;
    float lost;
};

sea sea_eval(float2 p, float t, float height, float chop, float near_chop, float slope_gain, float resolved_gain, float footprint, uniform int stride)
{
    float fade = math::exp(-math::length(p) / FADE);
    float sx = 0.0, sy = 0.0, jxx = 0.0, jyy = 0.0, jxy = 0.0, h = 0.0, lost = 0.0;
    for (int i = 0; i < BIG_COUNT; ++i) {
        float4 a = BIG_A[i];
        float4 b = BIG_B[i];
        float amp = height * a.w * fade;
        float th = a.z * (a.x * p.x + a.y * p.y) - b.x * t;
        float s = math::sin(th);
        float c = math::cos(th);
        float ka = a.z * amp;
        sx += a.x * ka * c;
        sy += a.y * ka * c;
        float qs = b.z * fade * s;
        jxx += qs * a.x * a.x;
        jyy += qs * a.y * a.y;
        jxy += qs * a.x * a.y;
        h += amp * s;
    }
    for (int i = 0; i < WAVE_COUNT; i += stride) {
        float4 a = WAVE_A[i];
        float4 b = WAVE_B[i];
        float lambda = 6.2831853 / a.z;
        float w = math::smoothstep(1.0, 2.5, lambda / footprint);
        float wj = math::smoothstep(0.7, 1.6, lambda / footprint);
        float amp = a.w * math::sqrt(float(stride)) * (lambda < 3.0 ? near_chop : chop);
        float th = a.z * (a.x * p.x + a.y * p.y) - (b.x * t - b.y);
        float s = math::sin(th);
        float c = math::cos(th);
        float ka = a.z * amp;
        sx += a.x * ka * w * resolved_gain * c;
        sy += a.y * ka * w * resolved_gain * c;
        float qs = b.z * ka * wj * s;
        jxx += qs * a.x * a.x;
        jyy += qs * a.y * a.y;
        jxy += qs * a.x * a.y;
        lost += 0.25 * ka * ka * slope_gain * slope_gain * (1.0 - w * w);
    }
    float jac = (1.0 - jxx) * (1.0 - jyy) - jxy * jxy;
    float3 n = float3(-jxy * sy - sx * (1.0 - jyy), -jxy * sx - sy * (1.0 - jxx), math::max(jac, 0.15));
    return sea(math::normalize(n), h, jac, lost);
}

float hash(float2 c)
{
    return math::frac(math::sin(c.x * 127.1 + c.y * 311.7) * 43758.5453);
}

float vnoise(float2 q)
{
    float2 i = math::floor(q);
    float2 f = q - i;
    float2 u = f * f * (3.0 - 2.0 * f);
    float a = hash(i);
    float b = hash(i + float2(1.0, 0.0));
    float c = hash(i + float2(0.0, 1.0));
    float d = hash(i + float2(1.0, 1.0));
    return math::lerp(math::lerp(a, b, u.x), math::lerp(c, d, u.x), u.y);
}

float noise(float2 p, float t, uniform float size, uniform int levels)
{
    float2 q = p / size;
    float e = t / size;
    float sum = 0.0;
    float norm = 0.0;
    float w = 1.0;
    for (int i = 0; i < levels; ++i) {
        float2 o = float2(e * (0.7 + 0.3 * float(i)), -e * (0.4 + 0.25 * float(i)));
        sum += w * 0.5 * (vnoise(q + o) + vnoise(q * 1.07 - o + float2(17.3, 9.1)));
        norm += w;
        q = float2(1.6 * q.x - 1.2 * q.y, 1.2 * q.x + 1.6 * q.y);
        w *= 0.5;
    }
    return sum / norm;
}

float ridge(float n, float width)
{
    return math::smoothstep(1.0 - width, 1.0, 1.0 - math::abs(2.0 * n - 1.0));
}

float4 legs_eval(float2 p)
{
    float2 perp = float2(-DRIFT.y, DRIFT.x);
    float ring = 0.0;
    float wash = 0.0;
    float wake = 0.0;
    float contact = 0.0;
    for (int i = 0; i < LEG_COUNT; ++i) {
        float3 l = LEGS[i];
        float2 rel = p - float2(l.x, l.y);
        float d = math::max(math::length(rel) - l.z, 0.0);
        ring = math::max(ring, math::max(math::exp(-d / 3.2), d < 0.7 ? 1.0 : 0.0));
        wash = math::max(wash, math::exp(-d / 12.0));
        contact = math::max(contact, 1.0 - math::smoothstep(0.3, 2.2, d));
        float along = math::dot(rel, DRIFT);
        float across = math::abs(math::dot(rel, perp));
        float spread = l.z * 1.1 + 0.2 * math::max(along, 0.0);
        float q = across / spread;
        if (along > 0.0)
            wake = math::max(wake, math::exp(-q * q) * math::exp(-along / 90.0));
    }
    return float4(ring, wash, wake, contact);
}

export material OceanFx(
    float time = 0.0,
    float height = 1.5,
    float chop = 1.0,
    float uv_tile = 26.0,
    color deep_color = color(0.0015, 0.007, 0.01),
    color crest_color = color(0.006, 0.03, 0.032),
    color aerated_color = color(0.03, 0.09, 0.085),
    color foam_color = color(0.62, 0.66, 0.66),
    float roughness = 0.025,
    float foam_threshold = 0.55,
    float foam_softness = 0.12,
    float foam_amount = 1.0,
    float leg_foam = 1.0,
    float leg_chop = 3.0,
    float grazing_gain = 0.8,
    float drift_speed = 0.6,
    float3 camera_position = float3(0.0, 0.0, 40.0),
    float pixel_angle = 0.0008,
    float min_footprint = 0.01,
    float slope_gain = 1.0,
    float debug = 0.0,
    uniform int wave_stride = 1,
    float debug_mode = 0.0
)
= let {
    float2 p = float2(state::texture_coordinate(0).x, state::texture_coordinate(0).y) * uv_tile;
    float3 pw = state::transform_point(state::coordinate_internal, state::coordinate_world, state::position());
    float3 to_cam = camera_position - pw;
    float dist = math::length(to_cam);
    float stretch = math::sqrt(1.0 / math::max(math::abs(to_cam.z) / math::max(dist, 1e-3), 0.05));
    float footprint = math::max(min_footprint, dist * pixel_angle * math::sqrt(stretch));

    float2 perp = float2(-DRIFT.y, DRIFT.x);
    float4 lg = legs_eval(float2(pw.x, pw.y));
    float contact = lg.w * math::min(leg_foam, 1.0);
    float grazing = 1.0 - math::abs(to_cam.z) / math::max(dist, 1e-3);
    float ring = lg.x;
    float wash = lg.y;
    float wake = lg.z;
    float near = math::max(ring, wash) * leg_foam;
    sea o = sea_eval(p, time, height, chop, chop * (1.0 + leg_chop * near), slope_gain, slope_gain * (1.0 + grazing_gain * grazing), footprint, wave_stride);
    float alpha = math::min(math::sqrt(roughness * roughness + 2.0 * o.lost) + 0.12 * ring * leg_foam, 0.35);

    float2 adv = p - DRIFT * (time * drift_speed);
    float2 dc = float2(math::dot(adv, DRIFT), math::dot(adv, perp));
    float lace = math::max(ridge(noise(adv, time * 0.08, 1.6, 3), 0.22), 0.8 * ridge(noise(adv * 2.7, time * 0.15, 1.6, 2), 0.3));
    float blob = noise(adv, time * 0.05, 7.0, 3);
    float streak = noise(float2(dc.x * 0.12, dc.y * 1.4), time * 0.03, 1.0, 3);
    float pattern = math::saturate(0.45 * lace + 0.35 * math::smoothstep(0.3, 0.7, blob) + 0.3 * math::smoothstep(0.35, 0.65, streak));

    float crest = math::saturate((foam_threshold - o.jac) / foam_softness);
    float residue = math::saturate((foam_threshold + 0.25 - o.jac) / 0.45) * math::smoothstep(0.4, 0.75, streak) * 0.7;
    float surge = 0.7 + 0.3 * math::saturate(o.h / math::max(height, 0.1) + 0.5);
    float leg = leg_foam * surge * math::max(math::max(ring, 0.8 * wash), 0.9 * wake * (0.4 + 0.6 * math::smoothstep(0.3, 0.7, streak)));
    float m = math::saturate(math::max(math::max(foam_amount * math::max(crest, residue), leg), contact));
    float foam = math::max(m <= 0.001 ? 0.0 : math::smoothstep(1.0 - m, 1.2 - m, pattern + 0.15 * m) * math::min(1.0, m * 3.0), contact * (0.7 + 0.3 * pattern));

    float crest_tint = math::pow(math::saturate(o.h / math::max(height, 0.1) * 0.7 + 0.3), 2.0);
    color body0 = math::lerp(deep_color, crest_color, crest_tint);
    color body = math::lerp(body0, aerated_color, math::saturate(1.4 * math::max(m, 0.5 * wash * leg_foam)) * (1.0 - foam));
    float3 n = state::transform_normal(state::coordinate_world, state::coordinate_internal, o.n);
    bsdf water = df::fresnel_layer(
        ior: 1.333,
        layer: df::microfacet_ggx_smith_bsdf(roughness_u: alpha, roughness_v: alpha, tint: color(1.0), mode: df::scatter_reflect),
        base: df::diffuse_reflection_bsdf(tint: body)
    );
    bsdf froth = df::fresnel_layer(
        ior: 1.333,
        layer: df::microfacet_ggx_smith_bsdf(roughness_u: 0.35, roughness_v: 0.35, tint: color(1.0), mode: df::scatter_reflect),
        base: df::diffuse_reflection_bsdf(tint: foam_color * (0.75 + 0.25 * pattern), roughness: 0.6)
    );
} in material(
    surface: material_surface(
        scattering: df::weighted_layer(weight: foam, layer: froth, base: water),
        emission: material_emission(emission: df::diffuse_edf(), intensity: debug * (debug_mode > 0.5 ? color(0.5 + 0.5 * o.n.x, 0.5 + 0.5 * o.n.y, alpha * 3.0) : color(math::frac(p.x / 20.0) * 0.2, m, foam)), mode: intensity_radiant_exitance)
    ),
    geometry: material_geometry(normal: n)
);
