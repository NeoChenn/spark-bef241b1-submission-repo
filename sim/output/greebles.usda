                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor.connect = </World/Greebles/Looks/practical_sign/diff.outputs:rgb>
                    color3f inputs:emissiveColor.connect = </World/Greebles/Looks/practical_sign/emit.outputs:rgb>
                    float inputs:roughness = 0.5
                    token outputs:surface
                }

                def Shader "uv"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "diff"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../assets/generated/greebles/muster.jpg@
                    float4 inputs:scale = (1, 1, 1, 1)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Greebles/Looks/practical_sign/uv.outputs:result>
                    float3 outputs:rgb
                }

                def Shader "emit"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @../assets/generated/greebles/muster.jpg@
                    float4 inputs:scale = (3, 3, 3, 1)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </World/Greebles/Looks/practical_sign/uv.outputs:result>
                    float3 outputs:rgb
                }
            }

