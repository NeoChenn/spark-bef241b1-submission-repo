# Copy to .env and fill in. .env is gitignored. Never paste real keys into this file.

# Cloudflare tunnel token for the rig sim stream (see README, "Cloudflare setup")
TUNNEL_TOKEN=

# Gemini API key from the temporary hackathon account (aistudio.google.com/api-keys)
GEMINI_API_KEY=

# Model IDs: look up the current names in AI Studio and the Gemini skills. Left blank on purpose.
GEMINI_REASONING_MODEL=
GEMINI_FALLBACK_MODEL=

# Guard against runaway usage (the organisers disqualify abuse)
GEMINI_MAX_CALLS_PER_MINUTE=20
