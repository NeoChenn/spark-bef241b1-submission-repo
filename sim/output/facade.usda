#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    def Scope "Facade"
    {
        def Scope "Looks"
        {
            def Material "clad"
            {
                token outputs:mdl:surface.connect = </World/Facade/Looks/clad/rig_mdl.outputs:out>
                token outputs:surface.connect = </World/Facade/Looks/clad/rig_mdl.outputs:out>

                def Shader "rig_mdl"
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:mdl:sourceAsset = @../assets/mdl/rig_weathered.mdl@
                    uniform token info:mdl:sourceAsset:subIdentifier = "rig_weathered"
                    float inputs:chip_amount = 0.3
                    float inputs:grime_amount = 0.5
                    float inputs:macro_scale = 23
                    asset inputs:masks = @../assets/generated/rig_masks.png@ (
                        colorSpace = "raw"
                    )
                    float inputs:metallic = 0
                    color3f inputs:paint_color = (0.64, 0.65, 0.63)
                    asset inputs:paint_diff = @../assets/generated/facade/clad_diff.png@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:paint_normal = @../assets/generated/facade/clad_nor_gl.png@ (
                        colorSpace = "raw"
                    )
                    float inputs:paint_reference = 0.77
                    asset inputs:paint_rough = @../assets/generated/facade/clad_rough.png@ (
                        colorSpace = "raw"
                    )
                    float inputs:paint_scale = 4
                    float inputs:porosity = 0.35
                    float inputs:puddle_scale = 9
                    float inputs:puddles = 0
                    float inputs:rust_amount = 0.1
                    asset inputs:rust_diff = @../assets/third_party/textures/Rust007_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:rust_normal = @../assets/third_party/textures/Rust007_4k/nor_gl.jpg@ (
                        colorSpace = "raw"
                    )
                    asset inputs:rust_rough = @../assets/third_party/textures/Rust007_4k/rough.jpg@ (
                        colorSpace = "raw"
                    )
                    float inputs:rust_scale = 1.5
                    float inputs:salt_amount = 0.25
                    float inputs:streak_amount = 0.9
                    color3f inputs:streak_color = (0.15, 0.075, 0.035)
                    asset inputs:streaks = @../assets/generated/rig_streaks.png@ (
                        colorSpace = "raw"
                    )
                    bool inputs:tint_paint = 1
                    bool inputs:triplanar = 0
                    bool inputs:use_opacity = 0
                    float inputs:wetness = 0
                    token outputs:out
                }
            }

