                    uniform token info:mdl:sourceAsset:subIdentifier = "rig_hero_paint"
                    float inputs:chip_amount = 0.8
                    asset inputs:chip_mask = @../assets/third_party/textures/PaintedMetal010_4k/diff.jpg@ (
                        colorSpace = "raw"
                    )
                    asset inputs:grime_tex = @../assets/third_party/textures/SurfaceImperfections011/diff.jpg@ (
