#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "Cinematic"
    {
        over "ocean" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/OceanFx/Looks/OceanFx>
        }

        over "foam_0" (
            active = false
        )
        {
        }

        over "foam_1" (
            active = false
        )
        {
        }

        over "foam_2" (
            active = false
        )
        {
        }

        over "foam_3" (
            active = false
        )
        {
        }
    }

    def Scope "OceanFx"
    {
        def Scope "Looks"
        {
            def Material "OceanFx"
            {
                token outputs:mdl:surface.connect = </World/OceanFx/Looks/OceanFx/Shader.outputs:out>
                token outputs:surface.connect = </World/OceanFx/Looks/OceanFx/Shader.outputs:out>

                def Shader "Shader"
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:mdl:sourceAsset = @./ocean_fx.mdl@
                    uniform token info:mdl:sourceAsset:subIdentifier = "OceanFx"
                    float inputs:uv_tile = 26
                    token outputs:out
                }
            }
        }
    }
}

