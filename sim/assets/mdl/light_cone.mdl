mdl 1.7;

import ::anno::*;
import ::df::*;
import ::math::*;
import ::state::*;

float ramp(float e0, float e1, float x) {
    float t = math::clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

export material light_cone(
    color tint = color(1.0),
    float gain = 1.0,
    float presence = 0.3,
    float3 apex = float3(0.0),
    float3 axis = float3(0.0, 0.0, -1.0),
    float length = 1.0,
    float3 eye = float3(0.0),
    float visible = 1.0,
    float time = 0.0
) = let {
    float3 p = state::transform_point(state::coordinate_internal, state::coordinate_world, state::position());
    float3 n = math::normalize(state::transform_normal(state::coordinate_internal, state::coordinate_world, state::geometry_normal()));
    float3 d = eye - p;
    float dist = math::max(math::length(d), 1.0e-4);
    float facing = math::abs(math::dot(n, d / dist));
    float s = math::clamp(math::dot(p - apex, axis) / length, 0.0, 1.0);
    float along = ramp(0.0, 0.08, s) * math::pow(1.0 - s, 1.3) * (1.0 - ramp(0.7, 1.0, s));
    float near = ramp(2.0, 8.0, dist);
    float motes = 0.82 + 0.18 * math::sin(p.x * 0.35 + 0.7 * time) * math::sin(p.y * 0.45 - 0.5 * time) * math::sin(p.z * 0.3 + 1.1 * time);
    float a = math::clamp(math::pow(facing, 1.5) * along * near * motes * visible, 0.0, 1.0);
    color e = tint * gain;
} in material(
    thin_walled: true,
    surface: material_surface(
        emission: material_emission(emission: df::diffuse_edf(), intensity: e * math::PI, mode: intensity_radiant_exitance)
    ),
    backface: material_surface(
        emission: material_emission(emission: df::diffuse_edf(), intensity: e * math::PI, mode: intensity_radiant_exitance)
    ),
    geometry: material_geometry(cutout_opacity: a * presence)
);
