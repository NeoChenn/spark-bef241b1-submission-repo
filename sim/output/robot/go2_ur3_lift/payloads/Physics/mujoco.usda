        def MjcActuator "FL_hip_joint_actuator"
        {
            uniform double mjc:forceRange:max = 23.700000762939453
            uniform double mjc:forceRange:min = -23.700000762939453
            custom rel mjc:target
            append rel mjc:target = </go2_ur3_lift/Physics/FL_hip_joint>
