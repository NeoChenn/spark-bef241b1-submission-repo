#usda 1.0
(
    upAxis = "Z"
)

over "World"
{
    over "Cinematic"
    {
        over "Flare"
        {
            over "flame_0"
            {
                token visibility = "invisible"
            }

            over "flame_1"
            {
                token visibility = "invisible"
            }

            over "flame_2"
            {
                token visibility = "invisible"
            }

            over "flame_3"
            {
                token visibility = "invisible"
            }

            over "flame_4"
            {
                token visibility = "invisible"
            }
        }

        over "Lamps"
        {
            over "lamp_400"
            {
                over "light"
                {
                    float inputs:radius = 6
                }
            }
        }
    }

    def Xform "FlareFx"
    {
        def Scope "Looks"
        {
            def Material "flame_0"
            {
                token outputs:mdl:surface.connect = </World/FlareFx/Looks/flame_0/shader.outputs:out>
                token outputs:surface.connect = </World/FlareFx/Looks/flame_0/shader.outputs:out>

                def Shader "shader"
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:mdl:sourceAsset = @../assets/mdl/flare_fx.mdl@
                    uniform token info:mdl:sourceAsset:subIdentifier = "flare_card"
                    asset inputs:atlas = @../assets/generated/flare_flame_atlas.png@ (
                        colorSpace = "raw"
                    )
                    float inputs:cols = 8
                    float inputs:frame = 0
                    float inputs:gain = 6000
                    float inputs:rows = 4
                    token outputs:out
                }
            }

            def Material "flame_1"
            {
                token outputs:mdl:surface.connect = </World/FlareFx/Looks/flame_1/shader.outputs:out>
                token outputs:surface.connect = </World/FlareFx/Looks/flame_1/shader.outputs:out>

