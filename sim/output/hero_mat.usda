#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "World"
{
    over "RepairZone"
    {
        over "Looks"
        {
            over "green_metal_rust"
            {
                token outputs:mdl:surface.connect = </World/RepairZone/Looks/green_metal_rust/hero_mdl.outputs:out>
                token outputs:surface.connect = </World/RepairZone/Looks/green_metal_rust/hero_mdl.outputs:out>

                def Shader "hero_mdl"
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:mdl:sourceAsset = @../assets/mdl/rig_hero.mdl@
                    uniform token info:mdl:sourceAsset:subIdentifier = "rig_hero_pipe"
                    asset inputs:chip_mask = @../assets/third_party/textures/PaintedMetal010_4k/diff.jpg@ (
                        colorSpace = "raw"
                    )
                    float inputs:chip_scale = 0.9424778
                    float3 inputs:damage = (18.2567, -5.655, 43.7199)
                    float inputs:damage_r = 0.1864
                    asset inputs:noise = @../assets/generated/hero_noise.png@ (
                        colorSpace = "raw"
                    )
                    asset inputs:paint_diff = @../assets/third_party/textures/green_metal_rust_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:paint_normal = @../assets/third_party/textures/green_metal_rust_4k/nor_gl.jpg@ (
                        colorSpace = "raw"
                    )
                    asset inputs:paint_rough = @../assets/third_party/textures/green_metal_rust_4k/rough.jpg@ (
                        colorSpace = "raw"
                    )
                    float inputs:paint_scale = 0.31415927
                    color3f inputs:paint_tint = (0.95, 1, 0.92)
                    float inputs:pipe_r = 0.15
                    float inputs:pipe_y = -5.75
                    float inputs:pipe_z = 43.6
                    asset inputs:rust_diff = @../assets/third_party/textures/Rust007_4k/diff.jpg@ (
                        colorSpace = "sRGB"
                    )
                    asset inputs:rust_normal = @../assets/third_party/textures/Rust007_4k/nor_gl.jpg@ (
                        colorSpace = "raw"
                    )
                    float inputs:rust_scale = 0.4712389
                    asset inputs:streaks = @../assets/generated/rig_streaks.png@ (
                        colorSpace = "raw"
                    )
                    float inputs:wetness = 0.64
                    token outputs:out
                }
            }

            over "rust_coarse_01"
            {
                token outputs:mdl:surface.connect = </World/RepairZone/Looks/rust_coarse_01/hero_mdl.outputs:out>
                token outputs:surface.connect = </World/RepairZone/Looks/rust_coarse_01/hero_mdl.outputs:out>

