        def Material "cinematic_sea"
        {
            token outputs:surface.connect = </World/Looks/cinematic_sea/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.002, 0.012, 0.016)
                float inputs:ior = 1.33
                normal3f inputs:normal.connect = </World/Looks/cinematic_sea/ripples.outputs:rgb>
                float inputs:roughness = 0.1
                token outputs:surface
            }

            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "scroll"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </World/Looks/cinematic_sea/uv.outputs:result>
                float2 inputs:translation = (0, 0)
                float2 outputs:result
            }

            def Shader "ripples"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @../assets/generated/sea_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </World/Looks/cinematic_sea/scroll.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

