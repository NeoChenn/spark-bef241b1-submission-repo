                    asset inputs:paint_normal = @../assets/third_party/textures/PaintedMetal010_4k/nor_gl.jpg@ (
                        colorSpace = "raw"
                    )
                    asset inputs:paint_rough = @../assets/third_party/textures/PaintedMetal010_4k/rough.jpg@ (
                        colorSpace = "raw"
