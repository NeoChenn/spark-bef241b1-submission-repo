                def Shader "hero_mdl"
                {
                    uniform token info:implementationSource = "sourceAsset"
                    uniform asset info:mdl:sourceAsset = @../assets/mdl/rig_hero.mdl@
                    uniform token info:mdl:sourceAsset:subIdentifier = "rig_hero_pipe"
                    asset inputs:chip_mask = @../assets/third_party/textures/PaintedMetal010_4k/diff.jpg@ (
                        colorSpace = "raw"
