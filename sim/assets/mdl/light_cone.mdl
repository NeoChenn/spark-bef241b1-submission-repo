mdl 1.7;

import ::anno::*;
import ::df::*;
import ::math::*;
import ::state::*;

float ramp(float e0, float e1, float x) {
    float t = math::clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

export material light_cone(
    color tint = color(1.0),
    float gain = 1.0,
    float presence = 0.5,
    float time = 0.0
) = let {
    float3 uv = state::texture_coordinate(0);
    float across = math::pow(math::sin(uv.x * 3.14159265), 2.0);
    float along = ramp(0.0, 0.06, uv.y) * math::pow(1.0 - uv.y, 1.3) * (1.0 - ramp(0.7, 1.0, uv.y));
    float motes = 0.85 + 0.15 * math::sin(uv.y * 23.0 - time * 1.3) * math::sin(uv.x * 11.0 + time * 0.7);
    float a = math::clamp(across * along * motes * presence, 0.0, 1.0);
    color e = tint * gain;
} in material(
    thin_walled: true,
    surface: material_surface(
        emission: material_emission(emission: df::diffuse_edf(), intensity: e * math::PI, mode: intensity_radiant_exitance)
    ),
    backface: material_surface(
        emission: material_emission(emission: df::diffuse_edf(), intensity: e * math::PI, mode: intensity_radiant_exitance)
    ),
    geometry: material_geometry(cutout_opacity: a)
);
